{
  "name": "playwright-ai-quality-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript E2E/API framework for RealWorld Conduit, with AI-written tests behind a human review gate",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
